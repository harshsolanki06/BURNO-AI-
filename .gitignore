# ─── Python / Backend ─────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.db
*.sqlite
*.sqlite3
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Backend secrets — keep local only
backend/.env
# but allow the example + railway template
!backend/.env.example
!backend/.env.railway

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
# keep .env.local and .env.production templates
!frontend/.env.local
!frontend/.env.production

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo

# ─── Test / temp files ────────────────────────────────────────────────────────
backend/test_*.py
backend/patch_*.py
backend/*.log

# ─── Uploaded knowledge docs (these are user data, not code) ──────────────────
backend/uploads/
