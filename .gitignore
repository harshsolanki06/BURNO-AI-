# ================================
# BURNO AI OS — .gitignore
# ================================

# ─── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Keep the example template
!.env.example

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
venv/
.venv/
env/
pip-wheel-metadata/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ─── Database (local dev) ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
.next/
.nuxt/
dist/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
