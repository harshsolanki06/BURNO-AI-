# ================================
# BURNO AI — Railway Environment Variables
# Copy these into Railway's dashboard → Variables tab
# ================================

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=BURNO AI OS
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# ─── CORS — set to true so all Vercel preview URLs work ───────────────────────
ALLOW_ALL_ORIGINS=true
# Or set specific Vercel URL: ALLOWED_ORIGINS=https://your-app.vercel.app

# ─── AI Keys — paste your keys here ──────────────────────────────────────────
GROQ_API_KEY=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
ANTHROPIC_API_KEY=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
OPENAI_API_KEY=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
ELEVENLABS_API_KEY=sk_0ddde1f6a1658db2a407bcf319aec88569e62120d0e7e36a
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Models ───────────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway provides PostgreSQL — use the DATABASE_URL Railway sets automatically
# OR keep SQLite for simplicity (Railway has ephemeral filesystem, use volume):
DATABASE_URL=sqlite+aiosqlite:///./burno.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# ─── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-burno
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
